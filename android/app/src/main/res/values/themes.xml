<?xml version="1.0" encoding="utf-8"?>
<!-- Activity window theme only (Compose MaterialTheme in Theme.kt owns in-app theming).
     Must exist: AndroidManifest references @style/Theme.MealWise or AAPT linking fails. -->
<resources>
    <style name="Theme.MealWise" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
</resources>
